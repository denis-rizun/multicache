ENV=PROD
COMPOSE_PROJECT_NAME=multicache
LOGGING_LEVEL_NAME=INFO

API_NAME=multicache
API_VERSION=1.0.0
API_PORT=8000
API_WORKERS=1
API_ALLOWED_HOSTS=["*"]
API_ALLOW_CREDENTIALS=true
API_ALLOWED_METHODS=["*"]
API_ALLOWED_HEADERS=["*"]

POSTGRES_DATABASE=multicache
POSTGRES_TEST_DATABASE=multicache_test
POSTGRES_USER=multicache_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
